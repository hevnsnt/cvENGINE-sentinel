# Copy this file to .env, keeping it private (it holds the blob): install -m 600 .env.example .env
# Or let ./setup.sh write .env for you (mode 600; re-running it changes only what you give it). README.md, "Environment variables",
# lists every variable. Docker Compose passes only the variables named in docker-compose.yml to the Sentinel.

# The one-time provisioning blob from the Sentinels page on your CVEngine instance (Provision). It is single-use and expires in 30 minutes;
# the Sentinel trades it for its own token on its first start and ignores it afterwards, so you can remove it from this file then.
CVENGINE_SENTINEL_BLOB=

# Optional: a name for this Sentinel on the Sentinels page. Defaults to the container's host name. Letters, digits, spaces and . _ - only.
# When set, it is reported to cvENGINE at every start; when unset, a rename made in cvENGINE sticks.
# CVENGINE_SENTINEL_NAME=office-scanner

# Full or light. COMPOSE_PROFILES=openvas also runs the Greenbone/GVM stack (FULL: tens of GB of feeds, hours of sync on the first start).
# Empty is LIGHT: nmap, naabu, nuclei, testssl, the UDP sweep and WPScan only. Unset, compose starts no OpenVAS containers; the value below
# is full. Keep CVENGINE_SENTINEL_PROFILE in step: the daemon reads that one (light never runs OpenVAS), while COMPOSE_PROFILES only decides
# which containers compose starts. Switching full to light needs one extra command: README.md, "Switching full to light".
COMPOSE_PROFILES=openvas
CVENGINE_SENTINEL_PROFILE=full

# Optional: internal when this machine sits inside a private network (an office LAN, a VPC, a VPN). Only then does the Sentinel scan private
# addresses (RFC 1918, CGNAT, fc00::/7), declare network:internal and run the discover sweep. Default: external, which refuses every private
# target. A ceiling: cvENGINE can lower it to external, never raise it to internal.
# CVENGINE_SENTINEL_NETWORK=internal

# Optional: a ceiling on self-update: off (never, even when an administrator presses Update now), manual (only when an administrator asks,
# even if cvENGINE says Automatic) or automatic. Unset, cvENGINE's setting applies. The updater must be installed (./setup.sh, or
# sudo ./scripts/install-updater.sh, Linux only) for any of this to happen.
# CVENGINE_SENTINEL_UPDATE=manual

# Optional: how many tasks run at once, OpenVAS not counted (OpenVAS has its own slot, one task at a time). Unset, it is detected from the
# CPUs the container may use. Capped at 10.
# CVENGINE_SENTINEL_MAX_CONCURRENT=2

# Optional: kinds this Sentinel never runs, comma separated: nmap, naabu, nuclei_light, nuclei_targeted, nuclei_deep, testssl, nmap_udp,
# wpscan, openvas, discover. A veto: cvENGINE can disable more kinds, never re-enable these. An unknown entry is ignored and logged once.
# CVENGINE_SENTINEL_DISABLE=wpscan

# Only for a lab server on plain http: the Sentinel refuses any server address that is not https unless this is exactly 1 (it then logs an
# INSECURE warning at every start).
# CVENGINE_SENTINEL_ALLOW_INSECURE=1

# Optional: a proxy for the Sentinel's connection to cvENGINE.
# HTTPS_PROXY=http://proxy.example.internal:3128
# NO_PROXY=

# Optional: the OpenVAS scanner's own log level. Unset it is 127 (no debug lines); 128 is debug and wrote about 50 MB for one 40 minute scan
# of one host, so set it only while debugging a scan, then docker compose up -d again.
# OPENVAS_LOG_LEVEL=128

# Optional: keep each GVM task, target and report after an OpenVAS run instead of deleting them, to investigate a scan (1, true, yes or on).
# CVENGINE_OPENVAS_KEEP_TASKS=1

# Written by scripts/install-updater.sh (and removed by its remove option) so cvENGINE shows the updater as installed. Do not set it by hand.
# CVENGINE_SENTINEL_UPDATER=installed

# Not passed by docker-compose.yml, so setting them here has no effect (put them under services.sentinel.environment in
# docker-compose.override.yml instead):
#   CVENGINE_OPENVAS_MAX_HOURS   this machine's ceiling on one OpenVAS task's time budget, in hours (default 24)
#   CVENGINE_SENTINEL_VERSION    a version for an image built without .git; the stamped commit always wins (scripts/update.sh deletes this line)

# Read by scripts/update.sh, not by the Sentinel: putting them in this file has no effect. Set them in the updater's environment instead:
# sudo systemctl edit cvengine-sentinel-update.service and add Environment=NAME=value under [Service] (or put them on the cron line).
#   CVENGINE_SENTINEL_DRAIN_TIMEOUT=1800   seconds to wait for running tasks before an update goes back to waiting (an OpenVAS scan can take hours)
#   CVENGINE_SENTINEL_BRANCH=main          the branch the updater follows; the checkout must be on it
