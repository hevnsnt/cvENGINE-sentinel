# Copy this file to .env and fill in the blob: cp .env.example .env
# Get the blob from the Sentinels page on your CVEngine instance (Provision button) or
# POST /api/v1/projects/{slug}/sentinels/enroll?format=blob. It is single-use and expires in 30 minutes; the Sentinel
# trades it for its own token on its first start and never needs it again.
CVENGINE_SENTINEL_BLOB=

# Optional: a name for this Sentinel in the Sentinels admin page. Defaults to the container's hostname.
# CVENGINE_SENTINEL_NAME=office-scanner

# Which Sentinel this is. ./setup.sh writes these for you (re-running it changes only what you give it); or set them by hand.
# COMPOSE_PROFILES=openvas runs the Greenbone/GVM stack too (FULL, several GB, hours of feed sync on the first start). Empty is LIGHT: nmap, naabu,
# nuclei, testssl and WPScan only. The default below is full. Keep CVENGINE_SENTINEL_PROFILE in step with it: the daemon reads that one
# (full or light), while COMPOSE_PROFILES only decides which containers compose starts.
COMPOSE_PROFILES=openvas
CVENGINE_SENTINEL_PROFILE=full

# Optional: set to internal when this Sentinel is deployed inside a private network (an office LAN, a VPC, a VPN) that the CVEngine
# server cannot reach. It then declares the network:internal capability, which is the only thing that lets the server hand it work
# for the internal ranges a project declared; an ordinary (external) Sentinel is never offered that work. Default: external.
# CVENGINE_SENTINEL_NETWORK=internal

# Optional: this machine's own self-update choice: off (never updates), manual (only when an administrator presses Update now on the Sentinels
# page) or automatic. Left unset, cvENGINE decides (the Sentinels page, or the instance default); the most recent change, there or here, wins.
# The updater itself is installed by ./setup.sh (or `sudo ./scripts/install-updater.sh`); with none installed this setting has no effect and the
# Sentinels page says so.
# CVENGINE_SENTINEL_UPDATE=manual

# Optional: how many nmap/naabu/nuclei/testssl/wpscan runs this Sentinel executes at once (an OpenVAS task is one GVM
# job, counted separately by gvmd itself). Left unset, this is auto-detected from the CPU the container actually has
# (capped at 10). Set a number to override the auto-detected value.
# CVENGINE_SENTINEL_MAX_CONCURRENT=2

# Optional: kinds of work this Sentinel never takes, comma-separated (for example openvas,wpscan).
# CVENGINE_SENTINEL_DISABLE=wpscan

# Optional: the OpenVAS scanner's own log level. Left unset it is the image default (127, no debug lines); 128 is debug and wrote about 50 MB
# for one 40 minute scan of one host, so set it only while debugging a scan, then `docker compose up -d` again.
# OPENVAS_LOG_LEVEL=128

# Optional: keep each OpenVAS task and report in gvmd after it finishes instead of deleting them, to investigate a scan (1 to keep).
# CVENGINE_OPENVAS_KEEP_TASKS=1

# Read by scripts/update.sh, not by the Sentinel: putting them in this file has no effect. Set them in the updater's environment instead:
# `sudo systemctl edit cvengine-sentinel-update.service` and add Environment=NAME=value under [Service] (or put them on the cron line).
# CVENGINE_SENTINEL_DRAIN_TIMEOUT=1800   seconds to wait for running tasks before an update goes back to waiting (an OpenVAS scan can take hours)
# CVENGINE_SENTINEL_BRANCH=main          the branch the updater follows; the checkout must be on it

# OpenVAS/GVM runs as the separate openvas-* services in docker-compose.yml (compose profile "openvas"), switched on or off by
# COMPOSE_PROFILES above.
